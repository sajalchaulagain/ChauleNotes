# ---------------------------------------------------------------------------
# ChauleNotes frontend environment (copy to .env)
# Only PUBLIC values belong here. The Firebase service-account key belongs in
# backend/.env, never in the React app.
# ---------------------------------------------------------------------------

# Python FastAPI backend (the "middleman" security guard)
VITE_PYTHON_API_URL=http://localhost:8000

# Firebase web app config:
# Firebase Console -> Project settings -> General -> Your apps -> Web app
# These values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:placeholder

# Optional: PWA settings
VITE_PWA_NAME=ChauleNotes
VITE_PWA_SHORT_NAME=ChauleNotes
VITE_PWA_DESCRIPTION="Every thought has a place."
