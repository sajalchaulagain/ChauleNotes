# ---------------------------------------------------------------------------
# ChauleNotes backend environment (copy to backend/.env)
# NEVER commit backend/.env or serviceAccountKey.json to GitHub.
# ---------------------------------------------------------------------------

# Firebase Admin SDK service account
# 1. Firebase Console -> Project settings -> Service accounts -> Generate new private key
# 2. Save the file as backend/serviceAccountKey.json. The backend detects this
#    default path automatically; set these only if using a different location.
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Alternative for hosts like Render/Railway: paste the whole service-account
# JSON as one line instead of uploading a file (takes priority when set).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional file storage. The secret is backend-only: never put it in VITE_*.
# Create a private bucket named chaule-notes-files in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_STORAGE_BUCKET=chaule-notes-files
MAX_ATTACHMENT_MB=20

# Comma-separated URLs allowed to call this API (Vite dev + Vercel production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-app.vercel.app

# Optional: these emails automatically become admins when their profile is created.
# You can also set role = "admin" manually in the Firestore `profiles` collection.
ADMIN_EMAILS=founder@example.com

