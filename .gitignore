# .gitignore for ChauleNotes
# Ignore node_modules and build artifacts
node_modules/
dist/
build/
.vite/

# Environment variables (Keep secrets safe!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and OS files
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Testing
coverage/

# ---------------------------------------------------------------------------
# Python backend
# ---------------------------------------------------------------------------
backend/.env
backend/serviceAccountKey.json
backend/serviceAccountKey*.json
backend/*firebase-adminsdk*.json
backend/__pycache__/
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Firebase local logs
firebase-debug.log
firestore-debug.log

# Vercel
.vercel/
