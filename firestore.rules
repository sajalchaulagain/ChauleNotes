rules_version = '2';

// ChauleNotes Firestore security rules (the replacement for database/policies.sql).
//
// IMPORTANT: React never talks to Firestore directly. Every read/write goes
// through the Python FastAPI backend, which uses the Firebase Admin SDK. Admin
// SDK requests bypass these rules, so denying all browser access is safe and is
// the most secure default: even if the public Firebase web config leaks, nobody
// can read or modify notes from a browser.
//
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste this file ->
// Publish. Or run: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
